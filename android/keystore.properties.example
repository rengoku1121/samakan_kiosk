# Salin ke android/keystore.properties (jangan di-commit) untuk build rilis.
# Buat keystore sekali saja:
#   keytool -genkeypair -v -keystore samakan-release.jks -alias samakan \
#           -keyalg RSA -keysize 2048 -validity 10000
storeFile=samakan-release.jks
storePassword=
keyAlias=samakan
keyPassword=
